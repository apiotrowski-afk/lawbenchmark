{
  "hosting": {
    "site": "lawbenchmark-pl",
    "public": "site",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {"source": "**/*.@(pdf)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}
    ]
  }
}
